    {
      "parameters": {
        "jsCode": "const text = $json.output || \"\";\n\nfunction extractValue(label, nextLabel) {\n  const regex = new RegExp(\n    `${label}:\\\\s*([\\\\s\\\\S]*?)${nextLabel ? nextLabel + \":\" : \"$\"}`,\n    \"i\"\n  );\n\n  const match = text.match(regex);\n\n  return match ? match[1].trim() : \"\";\n}\n\nconst summary = extractValue(\"SUMMARY\", \"CATEGORY\");\nconst category = extractValue(\"CATEGORY\", \"PRIORITY\");\nconst priority = extractValue(\"PRIORITY\", \"REPLY\");\nconst reply = extractValue(\"REPLY\", null);\n\nreturn [\n  {\n    json: {\n      ai_summary: summary || \"No Summary\",\n      ai_category: category || \"Other\",\n      ai_priority: priority || \"Medium\",\n      ai_reply: reply || text,\n    },\n  },\n];\n"
      },
